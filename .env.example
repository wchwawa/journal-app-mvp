# =================================================================
# EchoJournal environment configuration
# =================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
# Never commit `.env.local` or real keys to version control.

# =================================================================
# Authentication (Clerk)
# =================================================================
# Clerk supports keyless mode: leave both keys empty to start locally,
# then claim the app from the Clerk popup when ready.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Authentication redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard/overview"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard/overview"

# =================================================================
# Database & Storage (Supabase)
# =================================================================
# Found at: Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=    # Example: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # Example: sb_publishable_...
# WARNING: service role key has admin privileges; server-side only.
SUPABASE_SERVICE_ROLE_KEY=  # Example: sb_secret_...
# Used by `pnpm supabase:generate-types`
SUPABASE_PROJECT_ID=

# =================================================================
# OpenAI
# =================================================================
OPENAI_API_KEY=

# Model overrides (all optional — defaults live in src/lib/ai/models.ts).
# Note: gpt-5.x models reject custom `temperature` and use `max_completion_tokens`.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_REPHRASE_MODEL=gpt-5.6-luna
OPENAI_SUMMARY_MODEL=gpt-5.6-luna
OPENAI_REFLECTION_MODEL=gpt-5.6-luna
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_SEARCH_MODEL=gpt-4.1-mini

# =================================================================
# Timezone (IANA name; used for daily/weekly/monthly boundaries)
# =================================================================
NEXT_PUBLIC_APP_TIMEZONE=Australia/Sydney
APP_TIMEZONE=Australia/Sydney

# =================================================================
# Error tracking (Sentry) — optional
# =================================================================
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DISABLED="false"

# =================================================================
# Development only — NEVER set in production or shared environments
# =================================================================
# Skips Clerk middleware protection when NODE_ENV=development.
# Note: API routes still require a Clerk session; this only unlocks pages.
# DEV_DISABLE_AUTH=true

# =================================================================
# NoKV agent workspace (local showcase; disabled by default)
# =================================================================
# When enabled, every voice-agent session becomes a NoKV workbench:
# session metadata + ordered tool-call trace + deterministic commit.
# See docs/nokv-demo.md for the full local runbook.
NOKV_ENABLED=            # "true" to enable; anything else disables entirely
NOKV_BIN=                # e.g. /path/to/NoKV/target/release/nokv (build from main)
NOKV_ROOT_ID=            # 32-char lowercase hex (openssl rand -hex 16)
NOKV_ETCD_ENDPOINT=http://127.0.0.1:2379
NOKV_ETCD_KEY_PREFIX=/nokv/control
NOKV_OBJECT_ENDPOINT=http://127.0.0.1:9000
NOKV_OBJECT_BUCKET=echojournal-nokv
NOKV_OBJECT_ROOT=echojournal
NOKV_OBJECT_REGION=us-east-1
NOKV_OBJECT_ACCESS_KEY_ID=rustfsadmin
NOKV_OBJECT_SECRET_ACCESS_KEY=rustfsadmin
NOKV_WORKBENCH_ROOT=/agents/echojournal/wb
NOKV_SESSION_SECRET=     # openssl rand -hex 32; signs per-user session refs
